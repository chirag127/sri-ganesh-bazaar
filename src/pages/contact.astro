---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getShopDetails } from '../data/catalog';
import { whatsappLink } from '../lib/whatsapp';
const shop = getShopDetails(import.meta.env);
const whatsapp = whatsappLink(import.meta.env.PUBLIC_ENABLE_WHATSAPP, import.meta.env.PUBLIC_WHATSAPP_NUMBER);
---
<BaseLayout title="Contact the shop" description="Contact and collection information for Pashu Saathi, operated by Shri Ganesh Trading Company."><div class="container"><header class="page-heading"><p class="eyebrow">Before you travel</p><h1>Contact the shop</h1><p>Confirm your bags, quote and collection arrangements before making a journey. We do not use a courier booking service.</p></header><div class="contact-grid"><dl class="contact-details"><div><dt>Shop phone</dt><dd>{shop.phone ? <a href={shop.phoneHref}>{shop.phone}</a> : 'Not supplied yet. Phone enquiries are not enabled.'}</dd></div><div><dt>Shop address</dt><dd>{shop.address || 'Not supplied yet. Do not travel based on this preview.'}</dd></div><div><dt>Opening hours</dt><dd>{shop.hours || 'Not supplied yet. Confirm opening hours with the shop when contact details become available.'}</dd></div></dl><aside class="help-aside"><h2>Collection & delivery</h2>{whatsapp && <div><a class="button secondary" href={whatsapp} rel="noreferrer">Contact the shop on WhatsApp</a><p>Opens WhatsApp. Sending a message does not place an order, reserve stock or confirm payment.</p></div>}<p>Choose shop pickup, your own driver, or request shop-arranged tempo/e-rickshaw delivery. Availability and transport charges are confirmed in your quote.</p><a class="button" href="/app/#cart">Open your bag list</a><p>The portfolio email in the footer belongs to the developer, not the shop. Do not send customer or payment information there.</p></aside></div></div></BaseLayout>
