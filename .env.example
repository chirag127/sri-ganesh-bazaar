# Configuration inventory — placeholders only; NEVER put real credentials in this file.
# See okf/credentials.md for acquisition steps, destinations, and migration blockers.
# PUBLIC_* values are embedded in web/Android builds. Everything else stays server/CI-only.
# Copy only the section needed by that runtime; do not load the umbrella .env into Vite.
# Shared secrets: C:/ws/.env. App-specific secrets: this repository's .env.
# Both real files must stay ignored/uncommitted, even in a private repository.
# Preserve existing Neon-generated .env.local values; do not overwrite it with this file.
# Automatic shared-file loading is NOT implemented. Copy only approved keys per runtime.
# Standalone Node/Android scripts need explicit environment loading; this template does not load itself.

# REQUIRED public site origin. Set to the owner-approved HTTPS hostname.
PUBLIC_SITE_URL=https://vikas.oriz.in
# REQUIRED for launch: owner-provided shop contact, physical address, and opening hours.
PUBLIC_SHOP_PHONE=
PUBLIC_SHOP_ADDRESS=
PUBLIC_SHOP_HOURS=

# LEGACY / migration only: current catalog/release code still references these.
# Do not create a Supabase project or insert Neon credentials here to satisfy checks.
# Existing Supabase users: Project Settings > API, URL and publishable/legacy anon key ONLY.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# REQUIRED Neon client endpoints (public URLs, never database credentials).
# Copy NEON_AUTH_BASE_URL from `neon env pull` into PUBLIC_NEON_AUTH_URL.
# Obtain the commerce invocation_url with `neon functions get commerce` after deployment.
PUBLIC_NEON_AUTH_URL=
PUBLIC_COMMERCE_API_URL=

# REQUIRED Neon server auth metadata: obtain via `neon env pull` after Auth is deployed.
# These are endpoint URLs, NOT OAuth client secrets. Never invent an issuer/JWKS URL.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# REQUIRED runtime SECRET: pooled connection string for a dedicated SQL login granted
# ONLY commerce_runtime. Have the migration operator create/grant that login; obtain
# its connection string in Neon Connect. NEVER use the owner DATABASE_URL here.
COMMERCE_DATABASE_URL=
# REQUIRED server origin allowlist: explicit comma-separated web/native origins.
# Add localhost development origins only to the development deployment.
# Add the actual Capacitor origin only after verifying the native build configuration.
ALLOWED_ORIGINS=https://vikas.oriz.in
# REQUIRED policy attestation, not a token. Set true only after verifying Neon Auth
# allows Google sign-in only and the server validates its real token claim contract.
NEON_GOOGLE_ONLY_CONFIRMED=false
# Private evidence bucket declared in neon.ts; verify it remains private.
PAYMENT_EVIDENCE_BUCKET=assets
# REQUIRED storage runtime configuration. Obtain all AWS_* values via Neon env pull
# after Object Storage provisioning; these are Neon S3 credentials, not AWS IAM keys.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# OPTIONAL session credential only if supplied by Neon; never fabricate one.
AWS_SESSION_TOKEN=

# CLI/MIGRATION ONLY. `neon env pull` writes these into ignored .env.local.
# Preserve generated values there; do not copy them into PUBLIC_* or runtime DB config.
# DATABASE_URL may be an owner credential: use for reviewed migrations, not API traffic.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Migration runner only: obtain the direct connection for the reviewed migration owner
# from Neon Connect. Verify project/branch/database before supplying this secret.
# Run node scripts/migrate-database.mjs --apply with explicit process configuration.
# All pending migrations and checksum history commit atomically; never use a runtime login.
MIGRATION_DATABASE_URL=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=
# AI Gateway credentials come from env pull. No credits/models currently means no
# successful inference; do not buy credits or make paid calls just to pass a test.
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=
# CLI sign-in uses `neon login`; no NEON_API_KEY is needed for the existing OAuth login.
# Worker SQL login must inherit ONLY commerce_worker; its env name is not yet wired.

# OPTIONAL Firebase client settings: Firebase Console > Project settings > General >
# Your apps > registered Web app > SDK setup/config. Public config is not a service key.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# OPTIONAL web push public key: Project settings > Cloud Messaging > Web Push certificates.
PUBLIC_FIREBASE_VAPID_KEY=
# Keep false until each integration and server-side controls are verified.
# SMS requires separately approved Blaze billing; application limits cannot guarantee $0.
PUBLIC_ENABLE_SMS=false
PUBLIC_ENABLE_PUSH=false

# OPTIONAL server SMS/notification integration, currently still in legacy Edge code.
# These values alone do NOT enable a working Neon SMS or notification worker.
ENABLE_SMS=false
ENABLE_NOTIFICATIONS=false
# Firebase Console > Project settings > General: same project as optional client config.
FIREBASE_PROJECT_ID=
# SECRET: Project settings > Service accounts > Firebase Admin SDK > Generate new key.
# Store complete JSON in the deployment secret store, not in this template or PUBLIC_*.
FIREBASE_SERVICE_ACCOUNT_JSON=
# SECRET: Brevo account > SMTP & API > API Keys > generate scoped-purpose API key.
BREVO_API_KEY=
# Brevo > Senders & domains: verify sender/domain, then set that sender's email/name.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Pashudhan
# SECRET: generate a random 32-byte value locally; set identical value in worker and
# authorized scheduler secret stores. No browser receives it. See credentials.md.
NOTIFICATION_WORKER_SECRET=
# Legacy Supabase Edge-only values, not Neon credentials; leave blank during migration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL Android local build tool paths: installed JDK 21 and Android SDK location.
JAVA_HOME=
ANDROID_HOME=
# Alternative SDK path if ANDROID_HOME is not set.
ANDROID_SDK_ROOT=
# Android package identity. Must match Firebase/Play app registrations exactly.
ANDROID_APP_ID=in.oriz.sriganeshbazaar
# Release version from your release plan; increment code for each Play upload.
ANDROID_VERSION_CODE=
ANDROID_VERSION_NAME=
# Firebase Console > Project settings > registered Android app > download google-services.json.
# Supply its JSON through CI secret or process environment. This is NOT a service-account file.
ANDROID_GOOGLE_SERVICES_JSON=
# prepare-android derives ANDROID_FIREBASE_ENABLED; do not set it manually.
# Upload key: Android Studio > Build > Generate Signed App Bundle > create/select upload keystore.
# SECRET file stays OUTSIDE repo; workflow materializes it there from protected secret.
ANDROID_KEYSTORE_PATH=
# SECRET alternative for CI: Base64 of that keystore. Encoding does not encrypt it.
ANDROID_KEYSTORE_BASE64=
# SECRETS chosen when creating upload keystore; retain secure offline backup.
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
# Alias selected in the upload keystore; obtain with keytool -list interactively.
ANDROID_KEY_ALIAS=
# Nonsecret SHA-256 of upload certificate: keytool -list -v -keystore <outside-repo-path>.
ANDROID_UPLOAD_CERT_SHA256=
# ANDROID_SIGN_RELEASE is set by build script, not a user configuration switch.

# OPTIONAL future Play API secrets: create dedicated Google service account, enable
# Android Publisher API, invite account in Play Console with app-specific permissions.
# Actual upload script is currently fail-closed/not implemented; these do not fix that.
PLAY_SERVICE_ACCOUNT_FILE=
PLAY_SERVICE_ACCOUNT_JSON=
# Future supported release target only; never use these to bypass Console review.
PLAY_TRACK=internal
PLAY_RELEASE_STATUS=draft
PLAY_UPLOAD_APPROVED=false
PLAY_CONSOLE_BOOTSTRAPPED=false

# GitHub protected environment VARIABLES, not tokens. Keep false until evidence exists.
# Configure repository Settings > Environments > android-release with required reviewers.
RELEASE_ENVIRONMENT=android-release
RELEASES_ENABLED=false
RELEASE_ENVIRONMENT_CONFIGURED=false
RELEASE_PRIVACY_APPROVED=false
RELEASE_DATA_SAFETY_APPROVED=false
RELEASE_DELETION_APPROVED=false
RELEASE_CONTACT_APPROVED=false
RELEASE_DEVICE_TESTED=false
RELEASE_BACKUP_RESTORE_TESTED=false
RELEASE_SMS_BILLING_ACK=false
# Workflow derives RELEASE_APPROVED / RELEASE_APPROVED_SHA from an approved dispatch.
# GITHUB_* and the workflow's temporary KEY_BASE64 alias are provided by CI, not here.

# PLANNED INTEGRATIONS — reserved placeholders, NOT currently wired or operational.
# Filling these values does not install SDKs, configure consent, or enable delivery.
# Do not enable until implementation, privacy checks, and end-to-end tests pass.

# Google Analytics 4: https://analytics.google.com/
# Admin > Data streams > Web stream > Measurement ID (G-...). Public identifier.
# Never send customer names, phone numbers, addresses, notes, private prices or payment data.
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_ENABLE_ANALYTICS=false

# Microsoft Clarity: https://clarity.microsoft.com/
# Project > Settings > Setup: copy the project ID, not the complete script.
# PUBLIC browsing only; exclude authenticated, cart-estimate, quote, account and admin views.
# Mask inputs and sensitive rendered content; recheck exclusions during navigation/login.
PUBLIC_CLARITY_PROJECT_ID=
PUBLIC_ENABLE_CLARITY=false

# Sentry: https://sentry.io/
# Project Settings > Client Keys (DSN). DSNs identify ingestion, not administrative access.
# Browser and server projects may use different DSNs. Scrub PII, tokens, bodies and query strings.
# Session replay stays disabled; friendly fallback screens must work without Sentry.
PUBLIC_SENTRY_DSN=
PUBLIC_ENABLE_SENTRY=false
SENTRY_DSN=
ENABLE_SENTRY=false
# Optional CI-only source-map upload: organization/project slugs and a scoped upload token.
# Create the token in Sentry settings; never expose it as PUBLIC_* or ship source maps publicly.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Telegram ADMIN alerts only: https://t.me/BotFather
# Create a bot using /newbot; store its token server-side. Add it to the intended private
# admin chat and obtain that chat ID via an authorized Bot API update or setup tool.
# Do not send tokens in browser URLs or chat. No customer/payment details in alert bodies.
# Respect rate limits; do not enable paid broadcasts. Messaging is not unlimited.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
ENABLE_TELEGRAM_ALERTS=false
# Dedicated worker login granted ONLY commerce_worker; obtain its pooled URL from Neon.
# Never reuse DATABASE_URL or COMMERCE_DATABASE_URL. Server-only secret.
COMMERCE_WORKER_DATABASE_URL=
# When enabled, neon.ts declares adminAlerts. An authorized scheduler must send an
# empty POST with Authorization: Bearer <NOTIFICATION_WORKER_SECRET>.
# No scheduler is provisioned by this template. Disabling locally does not stop an
# already deployed worker: explicitly disable its deployed flag and scheduler.

# WhatsApp click-to-chat: owner-approved business number, country code + digits, no '+'
# or spaces. Example link format: https://wa.me/<number>. No API token is needed for
# click-to-chat. Automated WhatsApp Business messaging is separate and not configured.
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_ENABLE_WHATSAPP=false

# Private Neon counters: reuse the restricted commerce backend, not another owner URL.
# Aggregate demand/sales separately; no client-supplied arbitrary SQL or public customer history.
ENABLE_INTERNAL_ANALYTICS=false
# AI analysis: existing NEON_AI_GATEWAY_* above only if that provider is selected and funded.
# Send approved aggregates only; exclude identities, notes, receipts and private unit prices.
# AI suggestions must not autonomously change stock, prices, approvals or financial records.
ENABLE_AI_ANALYSIS=false

# TWO ANDROID TARGETS — local build routing implemented; native login/builds remain unverified.
# Select legacy, customer, or admin explicitly in the process environment before android:sync/build.
# Standalone Android scripts do not automatically load this template or app .env files.
ANDROID_TARGET=legacy
# Existing ANDROID_APP_ID above is the legacy identity; do not silently rename it.
# Reserve distinct IDs before Firebase/Google OAuth/Play registration. Final IDs remain unset.
# Both targets share backend identity; admin access is granted in the database, not via env email.
ANDROID_CUSTOMER_APP_ID=
ANDROID_ADMIN_APP_ID=
# Optional target-specific Firebase Android configuration, not service-account credentials.
# Download from Firebase Project settings for the matching registered Android package.
# Existing valid native files are preserved when these inputs are absent.
ANDROID_CUSTOMER_GOOGLE_SERVICES_JSON=
ANDROID_ADMIN_GOOGLE_SERVICES_JSON=
# Each release needs its own validated configuration/signing selection and device tests.
# Admin distribution choice: Play internal track. Do not upload until separately approved.

# OWNER DATA, NOT ENV SECRETS: maintain actual products, unit prices, stock counts,
# customer approvals, per-item low-stock thresholds and delivery ranges in admin/database.
# Public catalog prices must be omitted server-side. Estimates require shop approval.
# Quotes/bills calculate from stored prices with explicit owner overrides and transport.
# None of those authorization/business rules is enabled merely by filling this template.
