---
import type { Product } from '../lib/types';
import { getCategories } from '../data/catalog';
interface Props { products: Product[]; selected?: string; }
const { products, selected } = Astro.props;
const categories = getCategories(products);
const current = selected ?? Astro.url.searchParams.get('category') ?? '';
const href = (slug: string) => {
  const url = new URL(Astro.url);
  if (slug) url.searchParams.set('category', slug); else url.searchParams.delete('category');
  return url.href;
};
---

<div class="category-rail" aria-label="Shop by category">
  <a class:list={['category-chip', { active: current === '' }]} href={href('')} aria-current={current === '' ? 'true' : undefined}>All</a>
  {categories.map((category) => <a class:list={['category-chip', { active: current === category.slug }]} href={href(category.slug)} aria-current={current === category.slug ? 'true' : undefined}>{category.name}</a>)}
</div>
<style>
  .category-rail {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0 max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    margin-top: 0.5rem;
    -webkit-overflow-scrolling: touch;
  }
  .category-rail > a {
    flex: 0 0 auto;
    min-height: 36px;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 1.6rem;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }
  .category-rail > a:hover { border-color: var(--primary); color: var(--primary); background: var(--primary-contrast); }
  .category-rail > a.active {
    background: var(--primary);
    color: var(--primary-contrast);
    border-color: var(--primary);
    box-shadow: var(--shadow);
  }
  .category-rail > a:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  @media (min-width: 640px) {
    .category-rail { margin-top: 1rem; padding-inline: 0; }
    .category-rail > a { font-size: 0.85rem; padding: 0.6rem 1rem; }
  }
</style>
