---
interface Props { label?: string; weight?: string; }
const { label = 'Whole bags', weight = 'BAGGED ESSENTIALS' } = Astro.props;
---
<div class="bag-wrap" aria-hidden="true">
  <div class="bag-drawing">
    <svg class="bag-emblem" viewBox="0 0 40 40" fill="none">
      <path d="M20 35V6M20 24L10 16M20 29L30 21M20 16L12 9M20 20L28 12" stroke-width="1.7" stroke-linecap="round" />
      <ellipse cx="9" cy="14" rx="3" ry="5" transform="rotate(-35 9 14)" stroke-width="1.4" />
      <ellipse cx="30" cy="19" rx="3" ry="5" transform="rotate(35 30 19)" stroke-width="1.4" />
      <ellipse cx="12" cy="7" rx="2.5" ry="4" transform="rotate(-35 12 7)" stroke-width="1.4" />
      <ellipse cx="29" cy="10" rx="2.5" ry="4" transform="rotate(35 29 10)" stroke-width="1.4" />
    </svg>
    <div class="bag-label"><span>Generic illustration</span><strong>{label}</strong></div>
    <span class="bag-weight">{weight}</span>
  </div>
</div>
